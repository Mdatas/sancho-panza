{
  "name": "aoe2coach",
  "productName": "Sancho Panza - Age of Empires 2 Fan Companion",
  "version": "0.24.0",
  "description": "Sancho Panza - Age of Empires 2 Fan Companion: companion para Age of Empires II DE — coach con IA, build orders, counters, voz",
  "main": "src/main/main.js",
  "author": "M",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "build:web": "node web/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"web/**/*.{js,mjs}\" \"test/**/*.js\"",
    "smoke": "xvfb-run -a electron . --no-sandbox --smoke",
    "test:web": "node test/web.spec.mjs"
  },
  "dependencies": {
    "msedge-tts": "2.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "path-browserify": "^1.0.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "ar.m.aoe2coach",
    "productName": "Sancho Panza - Age of Empires 2 Fan Companion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "SanchoPanza-${version}-win-x64-unpacked.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon_1024.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "SanchoPanza-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Para hablarle al coach por voz.",
        "LSApplicationCategoryType": "public.app-category.games"
      }
    },
    "publish": null
  },
  "reviewedPatch": "185872",
  "homepage": "https://github.com/Mdatas/sancho-panza",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mdatas/sancho-panza.git"
  }
}
